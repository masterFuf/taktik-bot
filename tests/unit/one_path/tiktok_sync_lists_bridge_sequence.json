{
  "sync_account_from_app": {
    "calls": [
      "manager emulator-5554",
      "restart",
      "wait_app_surface",
      "permission_visible?",
      "permission_deny",
      "press_back",
      "detect_language",
      "fetch_own_profile",
      "workflow_built",
      "workflow_run as from_app",
      "force_stop tiktok"
    ],
    "configs": [
      {
        "incremental": true,
        "list_type": "following",
        "max_delay": 1.4,
        "max_resolutions": 50,
        "max_scrolls": 60,
        "min_delay": 0.6,
        "resolve_missing_handles": false
      }
    ],
    "events": [
      [
        "status",
        {
          "message": "Initializing TikTok following sync on emulator-5554",
          "status": "starting"
        }
      ],
      [
        "status",
        {
          "message": "Connecting to device",
          "status": "connecting"
        }
      ],
      [
        "status",
        {
          "message": "Restarting TikTok app",
          "status": "launching"
        }
      ],
      [
        "log",
        {
          "level": "info",
          "message": "Android permission dialog dismissed before starting"
        }
      ],
      [
        "log",
        {
          "level": "info",
          "message": "App language detected: FR"
        }
      ],
      [
        "status",
        {
          "message": "Fetching your TikTok profile info",
          "status": "fetching_profile"
        }
      ],
      [
        "workflow_start",
        {
          "list_type": "following",
          "target": "from_app"
        }
      ],
      [
        "status",
        {
          "message": "Reading the following list of @from_app",
          "status": "running"
        }
      ],
      [
        "sync_user_discovered",
        {
          "display_name": "Fan One",
          "is_new": true,
          "list_type": "following",
          "relationship": "Suivi(e)",
          "username": "fan_one"
        }
      ],
      [
        "sync_stats",
        {
          "stats": {
            "completion_reason": "known_reached",
            "elapsed_formatted": "0m 0s",
            "elapsed_seconds": 0,
            "errors": 0,
            "followers_seen": 0,
            "following_seen": 1,
            "new_count": 1,
            "reciprocal_seen": 0,
            "resolved": 0,
            "rows_seen": 1,
            "stopped_early": false,
            "unidentified": 0,
            "updated_count": 0
          }
        }
      ],
      [
        "status",
        {
          "completion_reason": "known_reached",
          "message": "1 row(s) recorded, 1 new",
          "status": "completed"
        }
      ]
    ],
    "exit": 0
  },
